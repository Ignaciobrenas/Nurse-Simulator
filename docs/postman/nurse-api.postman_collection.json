	"item": [
		{
			"name": "1. Create Nurse (POST /nurse)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test(\"Response contains created nurse data without password\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"id\");",
							"    pm.expect(jsonData.name).to.eql(\"Joy\");",
							"    pm.expect(jsonData.email).to.eql(\"joy@hospital.com\");",
							"    pm.expect(jsonData.password).to.be.undefined;",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Joy\",\n    \"email\": \"joy@hospital.com\",\n    \"password\": \"Password123\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/nurse",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"nurse"
					]
				}
			},
			"response": []
		},
